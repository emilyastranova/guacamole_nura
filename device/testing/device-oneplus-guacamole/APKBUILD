# Reference: <https://postmarketos.org/devicepkg>
# Co-Maintainer: Uclydde <julianbraha@gmail.com>
maintainer="Casey Connolly <kcxt@postmarketos.org>"
pkgname=device-oneplus-guacamole
pkgdesc="OnePlus 7 Pro"
pkgver=4
pkgrel=11
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck !strip !tracedeps"
depends="
	firmware-oneplus-guacamole
	linux-postmarketos-qcom-sm8150
	mkbootimg
	alsa-ucm-conf
	bluez-btmgmt
	e2fsprogs-extra
	hexagonrpcd
	hexagonrpcd-systemd
	hexagonrpcd-udev
	iio-sensor-proxy
	postmarketos-base
	msm-modem
	rmtfs
	tqftpserv
"
makedepends="devicepkg-dev"
# Sensor DSP support files read from a OnePlus 7 Pro's stock partitions
# (vendor_b sensor config, dsp_b SLPI libraries, persist registry snapshot).
# Not downloadable: generate it next to this APKBUILD with
#   scripts/extract_sensor_files.sh user@172.16.42.1 device/testing/device-oneplus-guacamole
_sensors="guacamole-sensors-20261014"
subpackages="$pkgname-openrc"
source="
	deviceinfo
	$pkgname-openrc.post-install
	guacamole-mpss.initd
	guacamole-chgctrl.initd
	guacamole-chgctrl.daemon
	guacamole-chgctrl.confd
	guacamole-chgctrl.service
	80-guacamole.preset
	sxmo_deviceprofile-oneplus-guacamole.sh
	90-wifi-wowlan.conf
	90-ath10k-wowlan.rules
	10-wifi-wowlan
	HiFi.conf
	guacamole.conf
	guacamole-bdaddr
	guacamole-bdaddr.service
	90-guacamole-bdaddr.rules
	guacamole-wlanmac
	90-guacamole-wlanmac.rules
	90-guacamole-sensors.rules
	61-guacamole-accel-mount-matrix.rules
	guacamole-sensors-registry
	guacamole-sensors-registry.service
	iio-sensor-proxy-guacamole.conf
	$_sensors.tar.gz
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Enable WoWLAN (magic + disconnect) by default (NM connection default).
	install -Dm644 "$srcdir/90-wifi-wowlan.conf" \
		"$pkgdir/usr/lib/NetworkManager/conf.d/90-wifi-wowlan.conf"

	# Force the Wi-Fi device wakeup-capable bit on so WoWLAN can wake from s2idle.
	install -Dm644 "$srcdir/90-ath10k-wowlan.rules" \
		"$pkgdir/usr/lib/udev/rules.d/90-ath10k-wowlan.rules"

	# Deterministically arm wake-on-wlan on the active Wi-Fi profile.
	install -Dm755 "$srcdir/10-wifi-wowlan" \
		"$pkgdir/etc/NetworkManager/dispatcher.d/10-wifi-wowlan"

	# ALSA UCM: TFA9874 speakers on QUAT_MI2S_RX, handset mic on SLIMBUS_0_TX.
	install -Dm644 "$srcdir/HiFi.conf" \
		"$pkgdir/usr/share/alsa/ucm2/OnePlus/guacamole/HiFi.conf"
	install -Dm644 "$srcdir/guacamole.conf" \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/sm8150/OnePlus 7 Pro.conf"

	# Bluetooth: stable public address derived from the factory Wi-Fi MAC.
	install -Dm755 "$srcdir/guacamole-bdaddr" "$pkgdir/usr/libexec/guacamole-bdaddr"
	install -Dm644 "$srcdir/guacamole-bdaddr.service" \
		"$pkgdir/usr/lib/systemd/system/guacamole-bdaddr.service"
	install -Dm644 "$srcdir/90-guacamole-bdaddr.rules" \
		"$pkgdir/usr/lib/udev/rules.d/90-guacamole-bdaddr.rules"

	# Wi-Fi: factory MAC as the interface address (NetworkManager still
	# applies its per-network stable MAC while connected).
	install -Dm755 "$srcdir/guacamole-wlanmac" "$pkgdir/usr/libexec/guacamole-wlanmac"
	install -Dm644 "$srcdir/90-guacamole-wlanmac.rules" \
		"$pkgdir/usr/lib/udev/rules.d/90-guacamole-wlanmac.rules"

	# Charge policy (USB PD contract, DCP, thermal throttling, charge window)
	install -Dm755 "$srcdir/guacamole-chgctrl.daemon" "$pkgdir/usr/libexec/guacamole-chgctrl"
	install -Dm644 "$srcdir/guacamole-chgctrl.confd" "$pkgdir/etc/conf.d/guacamole-chgctrl"
	install -Dm644 "$srcdir/guacamole-chgctrl.service" \
		"$pkgdir/usr/lib/systemd/system/guacamole-chgctrl.service"
	install -Dm644 "$srcdir/80-guacamole.preset" \
		"$pkgdir/usr/lib/systemd/system-preset/80-guacamole.preset"

	# Sensors: the SLPI sensor DSP is served its configuration, registry and
	# libraries by hexagonrpcd from /usr/share/qcom. The registry is per unit
	# and rewritten by the DSP, so it lives under /var/lib and is imported
	# from persist on first boot by guacamole-sensors-registry.
	local q="$pkgdir/usr/share/qcom" sd="$srcdir/$_sensors"
	mkdir -p "$q/sensors" "$q/socinfo"
	cp -r "$sd/sensors/config" "$q/sensors/config"
	install -m644 "$sd/sensors/sns_reg.conf" "$q/sensors/sns_reg.conf"
	cp -r "$sd/sdsp" "$q/sdsp"
	printf MTP > "$q/socinfo/hw_platform"
	printf 339 > "$q/socinfo/soc_id"
	printf Unknown > "$q/socinfo/platform_subtype"
	printf 0 > "$q/socinfo/platform_subtype_id"
	printf 65536 > "$q/socinfo/platform_version"
	printf 2.2 > "$q/socinfo/revision"
	ln -s /var/lib/guacamole/sensors/registry "$q/sensors/registry"
	ln -s /var/lib/guacamole/sensors/project_info "$q/project_info"
	local f
	for f in sns_reg_version file1 file2; do
		ln -s "/var/lib/guacamole/sensors/$f" "$q/sensors/$f"
	done
	mkdir -p "$pkgdir/usr/share/guacamole/sensors-registry-default"
	cp -r "$sd/registry-default/registry" \
		"$pkgdir/usr/share/guacamole/sensors-registry-default/registry"
	find "$q" "$pkgdir/usr/share/guacamole" -type f -exec chmod 644 {} +
	install -Dm755 "$srcdir/guacamole-sensors-registry" \
		"$pkgdir/usr/libexec/guacamole-sensors-registry"
	install -Dm644 "$srcdir/guacamole-sensors-registry.service" \
		"$pkgdir/usr/lib/systemd/system/guacamole-sensors-registry.service"
	install -Dm644 "$srcdir/90-guacamole-sensors.rules" \
		"$pkgdir/usr/lib/udev/rules.d/90-guacamole-sensors.rules"
	install -Dm644 "$srcdir/61-guacamole-accel-mount-matrix.rules" \
		"$pkgdir/usr/lib/udev/rules.d/61-guacamole-accel-mount-matrix.rules"
	install -Dm644 "$srcdir/iio-sensor-proxy-guacamole.conf" \
		"$pkgdir/usr/lib/systemd/system/iio-sensor-proxy.service.d/guacamole.conf"
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install"
	depends="tqftpserv-openrc openrc"
	install -Dm755 "$srcdir/guacamole-mpss.initd" \
		"$subpkgdir/etc/init.d/guacamole-mpss"
	install -Dm755 "$srcdir/guacamole-chgctrl.initd" \
		"$subpkgdir/etc/init.d/guacamole-chgctrl"
	# sxmo looks up device profiles by the exact "vendor,codename" compatible
	# string; abuild rejects commas in source= filenames, so the tracked file
	# uses dashes and gets installed under the comma name sxmo expects.
	install -Dm755 "$srcdir/sxmo_deviceprofile-oneplus-guacamole.sh" \
		"$subpkgdir/usr/bin/sxmo_deviceprofile_oneplus,guacamole.sh"
}



