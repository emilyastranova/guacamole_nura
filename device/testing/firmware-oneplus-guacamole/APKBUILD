pkgname=firmware-oneplus-guacamole
pkgdesc="OnePlus 7 Pro firmware (WiFi, Bluetooth, modem, IPA, GPU zap shader)"
pkgver=1
pkgrel=5
url="https://github.com/M1DNYT3/firmware-oneplus-guacamole"
license="proprietary"
arch="aarch64"
options="!check !archcheck !strip"
depends="firmware-qcom-adreno-a640"
_commit="f071a51faf6f6250c35662e8091deb2cb484a025"
_raw="https://raw.githubusercontent.com/M1DNYT3/firmware-oneplus-guacamole/$_commit"

_gpu="a640_zap.mdt a640_zap.b00 a640_zap.b01 a640_zap.b02"
_pd="modemuw.jsn"
# OxygenOS 11 modem: fits the 150 MiB mpss_mem region (0x8dc00000-0x97200000).
# The OxygenOS 12 modem spans 160 MiB and fails with "segment outside memory
# range" until the reserved-memory map is reworked.
_modem="modem.mdt modem.b00 modem.b01 modem.b02 modem.b03 modem.b04 modem.b05
	modem.b06 modem.b07 modem.b08 modem.b09 modem.b10 modem.b11 modem.b12
	modem.b13 modem.b14 modem.b15 modem.b17 modem.b18 modem.b19 modem.b20
	modem.b21 modem.b23 modem.b24 modem.b25 modem.b26 modem.b27 modem.b28
	modem.b29 modem.b30 modem.b31"

# WLAN firmware (wlanmdsp.mbn) and WCN3990 board data from the OxygenOS 12-era set
# in a LineageOS OTA. The OxygenOS 10/11 WLAN firmware (WLAN.HL.3.2.0) rejects
# station vdev start under mainline ath10k. This tarball is not downloadable:
# generate it next to this APKBUILD with
#   scripts/extract_lineage_firmware.py <lineage-*-guacamole-signed.zip> \
#       device/testing/firmware-oneplus-guacamole
_losfw="firmware-oneplus-guacamole-24.0-20261011"

# Generic WCN3990 host firmware descriptor (features/WMI/HTT IEs), from linux-firmware.
_linuxfw_tag="20260810"
source="30-gpu-firmware.files
	$_losfw.tar.gz
	firmware-5.bin::https://gitlab.com/kernel-firmware/linux-firmware/-/raw/$_linuxfw_tag/ath10k/WCN3990/hw1.0/firmware-5.bin"
for _f in $_gpu; do
	source="$source $_f::$_raw/qcom/$_f"
done
for _f in $_pd $_modem; do
	source="$source $_f::$_raw/qcom/sm8150/oneplus7/$_f"
done

package() {
	local f fw="$srcdir/$_losfw"

	# GPU zap shader (split ELF format for qcom_mdt_loader)
	for f in $_gpu; do
		install -Dm644 "$srcdir/$f" "$pkgdir/lib/firmware/qcom/$f"
	done

	# WCN3990 WiFi host firmware descriptor and board data
	install -Dm644 "$srcdir/firmware-5.bin" \
		"$pkgdir/lib/firmware/ath10k/WCN3990/hw1.0/firmware-5.bin"
	install -Dm644 "$fw/ath10k/WCN3990/hw1.0/board-2.bin" \
		"$pkgdir/lib/firmware/ath10k/WCN3990/hw1.0/board-2.bin"

	# MPSS modem firmware (required for WCN3990 WiFi via QRTR/WLFW)
	for f in $_modem; do
		install -Dm644 "$srcdir/$f" \
			"$pkgdir/lib/firmware/qcom/sm8150/oneplus7/$f"
	done

	# Served to the modem by tqftpserv: WLAN firmware and protection domain descriptor
	install -Dm644 "$fw/qcom/sm8150/oneplus7/wlanmdsp.mbn" \
		"$pkgdir/lib/firmware/postmarketos/qcom/sm8150/oneplus7/wlanmdsp.mbn"
	for f in $_pd; do
		install -Dm644 "$srcdir/$f" \
			"$pkgdir/lib/firmware/postmarketos/qcom/sm8150/oneplus7/$f"
	done

	# IPA firmware, loaded by the AP (qcom,gsi-loader = "self") for the modem data path
	install -Dm644 "$fw/qcom/sm8150/oneplus7/ipa_fws.mbn" \
		"$pkgdir/lib/firmware/qcom/sm8150/oneplus7/ipa_fws.mbn"

	# WCN3990 Bluetooth rampatch and NVM (OxygenOS 12-era, from the LineageOS bluetooth partition)
	for f in crbtfw21.tlv crnv21.bin; do
		install -Dm644 "$fw/qca/$f" "$pkgdir/lib/firmware/qca/$f"
	done

	# mkinitfs file list so GPU firmware is available before rootfs mounts
	install -Dm644 "$srcdir/30-gpu-firmware.files" \
		"$pkgdir/usr/share/mkinitfs/files/30-gpu-firmware.files"
}

